# 네이버 플레이스 영업 DB 수집기 - 개발자용 진단 환경 변수 예시
#
# 이 값들은 개발/디버깅 시 PC 상세 수집 엔진의 진단 모드를 켜기 위한 것입니다.
# 기본값은 모두 "안전 모드"(진단 기능 전부 비활성)이며, 별도 설정 없이도 정상 동작합니다.
#
# 중요: 패키징된 실행 파일(EXE, sys.frozen) 환경에서는 아래 값과 무관하게
#       항상 안전 모드로 강제됩니다(브라우저 화면 밖 실행, 진단 산출물 저장 없음).
#       따라서 최종 사용자 배포본에서는 이 파일이 필요하지 않습니다.

# 진단 모드 일괄 스위치. true면 아래 개별 값들의 기본값이 켜짐(개별 값으로 재정의 가능).
PCCRAWLER_DEBUG=false

# 브라우저 창을 화면에 보이게 실행할지 여부(false면 화면 밖 오프스크린 실행).
PCCRAWLER_VISIBLE=false

# 진단 산출물(스크린샷/HTML 등) 저장 여부. true면 logs/diagnostics에 저장.
PCCRAWLER_CAPTURE_ARTIFACTS=false

# 오류 발생 시 브라우저를 잠시 열어둘지 여부(디버깅용).
PCCRAWLER_KEEP_OPEN_ON_ERROR=false

# 상세 로그 출력 여부.
PCCRAWLER_VERBOSE=false

# keep_open_on_error가 true일 때 브라우저를 열어두는 시간(초). 0이면 대기 없음.
PCCRAWLER_KEEP_OPEN_TIMEOUT_SEC=0

# scripts/update_legal_dong_snapshot.py 전용 - 공공데이터포털(data.go.kr)
# "행정안전부_행정표준코드_법정동코드" Open API 활용신청으로 발급받은 서비스키.
# 이 키가 없으면 그 스크립트는 아무 네트워크 호출도 하지 않고 안내만 출력합니다.
# 런타임 앱(app.py) 실행에는 필요하지 않습니다(개발자 전용 갱신 도구).
DATA_GO_KR_SERVICE_KEY=
